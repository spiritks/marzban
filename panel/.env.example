# Copy to .env and edit before running.
PANEL_DOMAIN=panel.example.com
# Public HTTPS listener port for the admin panel reverse proxy.
# Use 443 for the standard URL, or e.g. 8443 if the panel must be exposed on a custom port.
# When this is not 443, include the same :PORT in PANEL_URL, ALLOWED_ORIGINS,
# XRAY_SUBSCRIPTION_URL_PREFIX, OAUTH2_PROXY_REDIRECT_URL, and the IdP callback URI.
PANEL_HTTPS_PORT=443
PANEL_URL=https://panel.example.com
ALLOWED_ORIGINS=https://panel.example.com

UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
DASHBOARD_PATH=/dashboard/

XRAY_SUBSCRIPTION_URL_PREFIX=https://panel.example.com
XRAY_SUBSCRIPTION_PATH=sub
SUB_PROFILE_TITLE=Company VPN
SUB_SUPPORT_URL=https://support.example.com
SUB_UPDATE_INTERVAL=12

# SQLite database stored in the mounted Marzban data directory.
# This keeps the deployment on the official upstream image without local PostgreSQL patches.
SQLALCHEMY_DATABASE_URL=sqlite:////var/lib/marzban/db.sqlite3

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
DOCS=False
DEBUG=False
XRAY_JSON=xray_config.json

# Upstream Marzban still requires its own admin JWT. These credentials are used
# only on localhost by the login bridge after OAuth succeeds, so browser users
# do not see the Marzban password form. Generate a strong random password.
SUDO_USERNAME=admin
SUDO_PASSWORD=CHANGE_ME_STRONG_RANDOM_MARZBAN_PASSWORD
MARZBAN_LOGIN_BRIDGE_PORT=4190

# OAuth2/OIDC gate for the admin panel via oauth2-proxy.
# This protects the panel before Marzban; the local login bridge then obtains
# Marzban's own dashboard token for the configured sudo admin.
# Configure your IdP redirect/callback URI as: https://panel.example.com/oauth2/callback
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.com/realms/example
OAUTH2_PROXY_CLIENT_ID=marzban-panel
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
# Must be exactly 32 raw bytes encoded with base64, e.g.:
# python3 - <<'PY'
# import secrets, base64
# print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())
# PY
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_32_BYTE_BASE64_SECRET
OAUTH2_PROXY_REDIRECT_URL=https://panel.example.com/oauth2/callback
OAUTH2_PROXY_SCOPE=openid profile email urn:zitadel:iam:org:id:<ORG_ID>
# Use a comma-separated list like admin@example.com,ops@example.com for stricter access.
OAUTH2_PROXY_EMAIL_DOMAINS=*

# Optional Telegram notifications.
# TELEGRAM_API_TOKEN=
# TELEGRAM_ADMIN_ID=

# Optional webhook notifications.
# WEBHOOK_ADDRESS=
# WEBHOOK_SECRET=
