{
    order forward_auth before reverse_proxy
}

(oauth_gate) {
    reverse_proxy 127.0.0.1:4180 {
        method GET
        rewrite /oauth2/auth
        header_up X-Forwarded-Method {method}
        header_up X-Forwarded-Uri {uri}

        @good status 2xx
        handle_response @good {
            request_header X-Auth-Request-User {rp.header.X-Auth-Request-User}
            request_header X-Auth-Request-Email {rp.header.X-Auth-Request-Email}
            request_header X-Auth-Request-Preferred-Username {rp.header.X-Auth-Request-Preferred-Username}
        }

        @unauthorized status 401
        handle_response @unauthorized {
            redir * /oauth2/start?rd={scheme}://{host}{uri} 302
        }
    }
}

{$PANEL_DOMAIN}:{$PANEL_HTTPS_PORT:443} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Marzban's upstream dashboard has its own password form. The login bridge
    # exchanges the already-approved OAuth session for a Marzban JWT and stores
    # it in dashboard localStorage so the built-in form is skipped.
    @root path /
    redir @root /marzban-login/ 302

    @dashboard_entry {
        path /dashboard /dashboard/
        not query sso=1
    }
    redir @dashboard_entry /marzban-login/?rd={uri} 302

    # OAuth2/OIDC callback endpoint used by oauth2-proxy.
    handle /oauth2/* {
        reverse_proxy 127.0.0.1:4180
    }

    # Public subscription/provisioning endpoints must stay reachable by clients.
    # If you change XRAY_SUBSCRIPTION_PATH in .env, mirror it here.
    handle /sub* {
        reverse_proxy 127.0.0.1:8000
    }

    # The Marzban login bridge is protected by OAuth and then issues the
    # upstream dashboard token. It must not be exposed without the OAuth gate.
    handle /marzban-login/* {
        import oauth_gate
        reverse_proxy 127.0.0.1:4190
    }

    # Admin dashboard and API are gated by oauth2-proxy first.
    handle {
        import oauth_gate
        reverse_proxy 127.0.0.1:8000
    }
}
