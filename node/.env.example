# Copy to .env and edit on every node server.
NODE_NAME=de1
NODE_DOMAIN=de1.example.com

# Paste the certificate shown by the Marzban panel into:
# ./data/marzban-node/cert.pem
# Marzban Node uses this client certificate; there is no separate key file to copy from the panel.
SSL_CLIENT_CERT_FILE=/var/lib/marzban-node/cert.pem

# Marzban panel connects to this node control API port.
SERVICE_PROTOCOL=rest
SERVICE_PORT=62050

# Internal Xray API port used by marzban-node. It must be free locally and must differ from SERVICE_PORT.
XRAY_API_PORT=62051

XRAY_PUBLIC_PORT=443
PANEL_PUBLIC_IP=CHANGE_ME_PANEL_IP
ADMIN_PUBLIC_IP=CHANGE_ME_ADMIN_IP
