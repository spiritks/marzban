# Copy to .env and edit on every node server.
NODE_NAME=de1
NODE_DOMAIN=de1.example.com

SSL_CERT_FILE=/var/lib/marzban-node/ssl_cert.pem
SSL_KEY_FILE=/var/lib/marzban-node/ssl_key.pem

XRAY_PUBLIC_PORT=443
PANEL_PUBLIC_IP=CHANGE_ME_PANEL_IP
ADMIN_PUBLIC_IP=CHANGE_ME_ADMIN_IP

# Optional. Uncomment only if your Marzban version/node setup expects REST.
# SERVICE_PROTOCOL=rest
